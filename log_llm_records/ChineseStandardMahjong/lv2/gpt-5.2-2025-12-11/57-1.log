u95f4\\uff0cT1 \\u4f5c\\u4e3a\\u8fb9\\u5f20\\u8054\\u7edc\\u6027\\u66f4\\u5dee\\uff08\\u4e3b\\u8981\\u53ea\\u80fd\\u8fde T2/T3\\uff09\\uff0c\\u800c T2 \\u8fd8\\u80fd\\u66f4\\u5bb9\\u6613\\u5f62\\u6210 123/234 \\u7684\\u4e2d\\u5f20\\u642d\\u5b50\\uff0c\\u56e0\\u6b64\\u5148\\u5f03 T1 \\u7565\\u4f18\\u3002\\n\\nAnswer: Play T1\"}"}
