6\\u6162\\u6210\\u578b\\u4e0e\\u756a\\u79cd\\uff08\\u4e5f\\u4e0d\\u5229\\u4e8e\\u505a\\u6e05\\u4e00\\u8272/\\u6df7\\u4e00\\u8272\\uff09\\u3002\\nReason: \\u5728\\u5b64\\u5f20\\u91cc\\uff0cW1\\u6700\\u96be\\u4e0e\\u73b0\\u6709\\u724c\\u914d\\u5408\\uff08\\u7f3aW2/W3\\u4e14\\u6211\\u4eec\\u5df2\\u7528\\u6389\\u4e00\\u526f\\u4e07\\u5b50\\u987a\\u5b50\\uff0c\\u7ee7\\u7eed\\u8d70\\u4e07\\u5b50\\u4e0d\\u73b0\\u5b9e\\uff09\\uff0c\\u800c\\u4e14\\u4ece\\u573a\\u51b5\\u770bW2/W1\\u4ecd\\u591a\\u4f46\\u6211\\u4eec\\u624b\\u91cc\\u4e07\\u5b50\\u5f62\\u5f88\\u5dee\\uff1b\\u7559W1\\u4e0d\\u5982\\u4fdd\\u7559B3/B6\\u4f5c\\u4e3a\\u53ef\\u80fd\\u7684\\u8fb9\\u5f20\\uff08B4/B5\\u6216B5/B7\\uff09\\u66f4\\u7075\\u6d3b\\u3002\\u4fdd\\u7559T6T6\\u4e0eT9T9\\u5219\\u80fd\\u7a33\\u5b9a\\u505a\\u5c06\\u5e76\\u63d0\\u9ad8\\u542c\\u724c\\u901f\\u5ea6\\uff0c\\u76ee\\u6807\\u5148\\u786e\\u4fdd\\u22658\\u756a\\u53ef\\u901a\\u8fc7\\u201c\\u767d\\u9f99\\u523b(2)+\\u57fa\\u672c\\u548c\\u724c(0)+\\u81ea\\u6478/\\u5355\\u9493\\u7b49\\u201d\\u4e0d\\u8db3\\uff0c\\u56e0\\u6b64\\u66f4\\u9700\\u8981\\u5c3d\\u5feb\\u6210\\u548c\\u540c\\u65f6\\u4e89\\u53d6\\u989d\\u5916\\u756a\\uff08\\u5982\\u518d\\u505a\\u4e00\\u526f\\u523b/\\u987a\\u3001\\u53ef\\u80fd\\u5e26\\u5e7a\\u4e5d/\\u5b57\\u7b49\\uff09\\uff0c\\u5148\\u63d0\\u901f\\u6700\\u5173\\u952e\\u3002\\nAnswer: Play W1\"}"}
